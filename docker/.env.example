# Copy to .env (gitignored) and fill in. Required:
# REPO=owner/name
# GH_TOKEN=
# Claude credential, one of:
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Optional commit identity (default: the GH_TOKEN owner and noreply address):
# ORCH_GIT_NAME=
# ORCH_GIT_EMAIL=

# Optional autopilot settings. A variable unset or empty clears its key at
# every start, so this file is the one source of truth (the watcher's default
# applies); permission mode instead defaults to bypassPermissions:
# ORCH_PERMISSION_MODE=
# ORCH_CAP=
# ORCH_HANDLE=
# ORCH_ROUNDS=
# ORCH_BUDGET=

# Optional models. ORCH_MODEL / ORCH_EFFORT are the headless phase session's
# model and effort. A role left unset inherits its starting session's, so
# ORCH_MODEL alone moves every role left unset; a role variable overrides it.
# Same unset-clears rule. A bad value stops the container at startup.
# ORCH_MODEL=
# ORCH_EFFORT=
# Roles: IMPLEMENTER, LENS, REVIEWER, FIXER, CLOSER, RESOLVER, e.g.
# ORCH_MODEL_IMPLEMENTER=
# ORCH_EFFORT_REVIEWER=

# Optional apt packages for the image, space-separated (e.g. shellcheck), for a
# repo whose tests need a tool the image lacks. Read when the image is built, so
# a change takes effect only with `docker compose up -d --build`:
# EXTRA_APT_PACKAGES=

# Where the clone lives (compose mounts the named volume here):
# ORCH_CLONE_DIR=/home/orch/repo

# A session signed in with CLAUDE_CODE_OAUTH_TOKEN may list the claude.ai
# account's anthropic-skills:* skills. Their names depend on the account, so
# none is turned off by default. To opt out, map each name to "off" in the
# skillOverrides setting of /home/orch/.claude/settings.json in the container
# (not on a volume, so a recreated container loses it), e.g.
# {"skillOverrides": {"anthropic-skills:<name>": "off"}}
