# Copy to .env (gitignored) and fill in. Required:
# REPO=owner/name
# GH_TOKEN=
# Claude credential, one of:
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Optional commit identity (default: the GH_TOKEN owner and noreply address):
# ORCH_GIT_NAME=
# ORCH_GIT_EMAIL=

# Optional autopilot settings (unset leaves the watcher's defaults;
# permission mode defaults to bypassPermissions in the container):
# ORCH_PERMISSION_MODE=
# ORCH_CAP=
# ORCH_HANDLE=
# ORCH_ROUNDS=
# ORCH_BUDGET=

# Where the clone lives (compose mounts the named volume here):
# ORCH_CLONE_DIR=/home/orch/repo

# A session signed in with CLAUDE_CODE_OAUTH_TOKEN may list the claude.ai
# account's anthropic-skills:* skills. Their names depend on the account, so
# none is turned off by default. To opt out, set the skillOverrides setting
# in the container's Claude Code settings, mapping each name to "off", e.g.
# {"skillOverrides": {"anthropic-skills:<name>": "off"}}
